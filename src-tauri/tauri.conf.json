{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hvyMETL",
  "version": "7.3.0",
  "identifier": "studio.hvymetl.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:3847",
    "beforeDevCommand": "npm run -s build && npm run -s build:ui",
    "beforeBuildCommand": "npm run -s build && npm run -s build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hvyMETL",
        "url": "http://127.0.0.1:3847",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
